# Port the dev/start server listens on. Next.js can't read PORT from .env on its
# own (the listener binds before its internal .env loading runs), so `pnpm dev`
# and `pnpm start` preload this file via dotenv-cli first — see package.json.
PORT=3000

# PostgreSQL connection string. Point this at any local or hosted Postgres instance.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]?schema=public"

# Public base URL this app is served at, used for metadata (Open Graph/canonical
# link resolution).
APP_URL="http://localhost:3000"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="[CHANGE_ME_TO_RANDOM_STRING]"
