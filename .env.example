# Port the dev/start server listens on. Next.js can't read PORT from .env on its
# own (the listener binds before its internal .env loading runs), so `pnpm dev`
# and `pnpm start` preload this file via dotenv's CLI first — see package.json.
PORT=3000

# PostgreSQL connection string. Point this at any local or hosted Postgres instance.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]?schema=public"

# Public base URL this app is served at, used for metadata (Open Graph/canonical
# link resolution).
APP_URL="http://localhost:3000"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="[CHANGE_ME_TO_RANDOM_STRING]"

# SMTP server used to send outgoing email. SMTP_HOST and SMTP_PORT are
# required: sign-in needs a confirmed email address.
# SMTP_SECURE=true connects over TLS from the start (port 465; empty means true
# on port 465 only). SMTP_REQUIRE_TLS=true fails unless the server upgrades the
# connection via STARTTLS (port 587). With neither, STARTTLS is used only when
# the server offers it, so mail and credentials can go out unencrypted.
# Both take true/1, false/0 or empty.
SMTP_USER="[SMTP USER]"
SMTP_PASS="[SMTP PASS]"
SMTP_HOST="[SMTP_HOST]"
SMTP_PORT=587
SMTP_SECURE=""
SMTP_REQUIRE_TLS=true

# "From" address/name used on outgoing email. Defaults to SMTP_USER if unset.
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="QR Code Generator"

# Support address shown in the footer of every outgoing email. Required.
SUPPORT_EMAIL="support@example.com"

# Google Analytics
GATAG_ID=

# Google Safe Browsing API key: create one in a Google Cloud project with the
# "Safe Browsing API" enabled, restricted to that API. QR code destinations are
# checked when saved and re-checked after scans; flagged codes stop redirecting.
# Empty turns the checks off. Safe Browsing is for non-commercial use only; a
# commercial service needs Google Web Risk instead.
SAFE_BROWSING_API_KEY=

# Extra origins allowed in the CSP's connect-src (space-separated), beyond
# 'self'. For example Google Analytics's collect beacons when GATAG_ID is set.
CSP_CONNECT_SRC_EXTRA=
