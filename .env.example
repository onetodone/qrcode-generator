# =============================================================================
# Server
# =============================================================================

# Port the dev/start server listens on. Next.js can't read PORT from .env on its
# own (the listener binds before its internal .env loading runs), so `pnpm dev`
# and `pnpm start` preload this file via dotenv's CLI first — see package.json.
PORT=3000

# Public base URL this app is served at. Used for metadata (Open Graph/canonical
# link resolution) and for links in outgoing email.
APP_URL="http://localhost:3000"

# Base URL of the `/s/<hash>` links baked into QR codes. Empty uses APP_URL.
# A printed code keeps its link for good, so pick a domain you'll keep. Point
# this domain at the app too: it serves `/s/*` and redirects every other path
# to APP_URL. Prefer a separate registrable domain over a subdomain of
# APP_URL's: a Safe Browsing listing of a domain covers all its subdomains.
SHORT_LINK_URL=

# Self-hosted only (ignored on Vercel). Which peers may set X-Forwarded-For /
# X-Real-IP, the client IP used in logs and rate limits.
#   private (default) — trusts a reverse proxy on loopback or a private network
#                       (same host, Docker network, LAN); requests from any
#                       other address get their socket address.
#   all               — trusts every peer, for a proxy on a public address
#                       (a CDN in front of the origin).
#   none              — trusts no peer.
TRUSTED_PROXY=

# =============================================================================
# Database (required)
# =============================================================================

# PostgreSQL connection string. Point this at any local or hosted Postgres
# instance.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]?schema=public"

# Docker Compose only: credentials of the bundled Postgres. Compose builds the
# app's DATABASE_URL from these and ignores the one above.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=qrcode_generator

# =============================================================================
# Authentication
# =============================================================================

# Auth.js secret (required). Generate with: openssl rand -base64 32
AUTH_SECRET="[CHANGE_ME_TO_RANDOM_STRING]"

# Sign-in providers (optional). Each provider is offered only when both of its
# variables are set. Register <APP_URL>/api/auth/callback/<provider> as the
# callback URL, e.g. /api/auth/callback/google. Microsoft work and school
# accounts also need the `xms_edov` optional claim. See the README's
# "Sign-in providers" section.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# =============================================================================
# Email (required: sign-in needs a confirmed email address)
# =============================================================================

# SMTP server used to send outgoing email. SMTP_HOST and SMTP_PORT are required.
SMTP_HOST="[SMTP_HOST]"
SMTP_PORT=587
SMTP_USER="[SMTP USER]"
SMTP_PASS="[SMTP PASS]"

# Connection encryption. Both take true/1, false/0 or empty.
#   SMTP_SECURE=true      — connects over TLS from the start (port 465). Empty
#                           means true on port 465 only.
#   SMTP_REQUIRE_TLS=true — fails unless the server upgrades the connection via
#                           STARTTLS (port 587).
# With neither, STARTTLS is used only when the server offers it, so mail and
# credentials can go out unencrypted.
SMTP_SECURE=""
SMTP_REQUIRE_TLS=true

# "From" address/name used on outgoing email. The address defaults to SMTP_USER
# if unset.
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="QR Code Generator"

# =============================================================================
# Contacts and legal pages
# =============================================================================

# Support address (required), shown in the footer of every outgoing email and as
# the contact on the Terms of Use and Privacy Policy pages.
SUPPORT_EMAIL="support@example.com"

# Address for abuse reports, shown on the Terms of Use page. Empty falls back to
# SUPPORT_EMAIL.
ABUSE_EMAIL=

# Operator of this instance (a person or an organization), named on the Terms of
# Use and Privacy Policy pages as the service operator and data controller.
# Empty shows a generic description instead.
LEGAL_OPERATOR_NAME=

# Country or state whose law governs the Terms and whose courts hear disputes.
# Empty leaves that section out. Review both pages before running a public
# instance.
LEGAL_JURISDICTION=

# =============================================================================
# Destination safety
# =============================================================================

# Google Safe Browsing API key: create one in a Google Cloud project with the
# "Safe Browsing API" enabled, restricted to that API. QR code destinations are
# checked when saved and re-checked after scans; flagged codes stop redirecting.
# Empty turns the checks off. Safe Browsing is for non-commercial use only; a
# commercial service needs Google Web Risk instead.
SAFE_BROWSING_API_KEY=

# =============================================================================
# Bot protection
# =============================================================================

# Cloudflare Turnstile widget: create one in the Cloudflare dashboard
# (Turnstile → Add widget, mode "Managed") for the APP_URL domain. With both
# keys set, registration and forgot-password always ask for the check, and
# sign-in asks for it after 3 failed attempts from an IP or for an account.
# Empty turns it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Analytics and Content Security Policy
# =============================================================================

# Google Analytics measurement ID. GA loads only after a visitor accepts
# analytics cookies in the consent banner; empty turns off GA and the banner.
GATAG_ID=

# Extra origins allowed in the CSP's connect-src (space-separated), beyond
# 'self'. For example Google Analytics's collect beacons when GATAG_ID is set.
CSP_CONNECT_SRC_EXTRA=
