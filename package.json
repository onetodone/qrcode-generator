{
  "name": "qrcode-generator",
  "version": "5.10.0",
  "description": "QR code generator with scan tracking — create QR codes, redirect scans through a short link, and see view counts per code.",
  "private": true,
  "author": "Anton Holubeu (https://github.com/aholu)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onetodone/qrcode-generator.git"
  },
  "homepage": "https://github.com/onetodone/qrcode-generator#readme",
  "bugs": {
    "url": "https://github.com/onetodone/qrcode-generator/issues"
  },
  "keywords": [
    "qrcode",
    "qr-code",
    "nextjs",
    "prisma",
    "auth.js",
    "link-tracking"
  ],
  "scripts": {
    "dev": "dotenv run -q -f .env -- next dev",
    "build": "next build",
    "start": "dotenv run -q -f .env -- node --import ./trusted-proxy.mjs node_modules/next/dist/bin/next start",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "qr:disable": "tsx scripts/qr-moderation.ts disable",
    "qr:enable": "tsx scripts/qr-moderation.ts enable",
    "user:suspend": "tsx scripts/account-suspension.ts suspend",
    "user:unsuspend": "tsx scripts/account-suspension.ts unsuspend"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@onetodone/mailer": "^0.3.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "phone": "^3.1.72",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
